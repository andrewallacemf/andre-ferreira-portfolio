---
import '../../../shared/tokens.css';
import '../styles/global.css';
import type { Content, Lang } from '../lib/content';
import { href, pageHref, type Page } from '../lib/paths';
import Header from '../components/Header.astro';
import DotGrid from '../components/DotGrid.astro';
import Cursor from '../components/Cursor.astro';

interface Props {
  lang: Lang;
  page: Page;
  t: Content;
  title?: string;
  slug?: string;
  description?: string;
}
const { lang, page, t, title, slug, description } = Astro.props;
const pageTitle = title ? `${title} · ${t.meta.title}` : t.meta.title;

// Absolute URLs for canonical, hreflang and Open Graph (Astro.site is always set).
const abs = (p: string) => new URL(p.replace(/^\//, ''), Astro.site).href;
const alt = (l: Lang) => abs(pageHref(l, page, '', slug));
const canonical = abs(pageHref(lang, page, '', slug));
// One Open Graph card per page, rendered by scripts/og.mjs into public/og/.
const ogKey = page === 'case' && slug ? slug : page;
const ogImage = abs(`og/${lang}-${ogKey}.png`);
const metaDescription = description ?? t.meta.description;
---

<!doctype html>
<html lang={lang === 'pt' ? 'pt-BR' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={href('favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={href('favicon-32.png')} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={href('apple-touch-icon.png')} />
    <meta name="theme-color" content="#0e0f12" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f5f5f2" media="(prefers-color-scheme: light)" />
    <meta property="og:type" content={page === 'case' ? 'article' : 'website'} />
    <meta property="og:site_name" content={t.meta.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={pageTitle} />
    <meta property="og:locale" content={lang === 'pt' ? 'pt_BR' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'pt' ? 'en_US' : 'pt_BR'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="alternate" hreflang="en" href={alt('en')} />
    <link rel="alternate" hreflang="pt-BR" href={alt('pt')} />
    <link rel="alternate" hreflang="x-default" href={alt('en')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:ital,wght@0,400..900;1,400..900&display=swap" />
    <script is:inline>
      /* Theme before first paint: stored choice wins, otherwise dark. */
      (function () {
        var theme = 'dark';
        try {
          var stored = localStorage.getItem('theme');
          if (stored === 'light' || stored === 'dark') theme = stored;
        } catch (e) {}
        var root = document.documentElement;
        root.setAttribute('data-theme', theme);
        /* Enable enter animations only with JS and without reduced motion. */
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches) root.setAttribute('data-motion', '');
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t.nav.skip}</a>
    <DotGrid />
    <Header lang={lang} page={page} t={t} slug={slug} />
    <main id="main" tabindex="-1" class:list={{ 'main--snap': page === 'home' }}>
      <slot />
    </main>
    <Cursor />
  </body>
</html>

<script>
  /* Slide enter animation: toggles .is-in on each .slide as it intersects. */
  const root = document.documentElement;
  const slides = Array.from(document.querySelectorAll<HTMLElement>('.slide'));
  const showAll = () => slides.forEach((s) => s.classList.add('is-in'));

  if (!('IntersectionObserver' in window) || !root.hasAttribute('data-motion')) {
    showAll();
  } else {
    const io = new IntersectionObserver(
      (entries) => entries.forEach((e) => e.target.classList.toggle('is-in', e.isIntersecting)),
      { threshold: 0.15 },
    );
    slides.forEach((s) => io.observe(s));
    /* Safety net: never leave content hidden if the observer never fires. */
    setTimeout(() => slides.forEach((s) => { if (!s.classList.contains('is-in')) s.classList.add('is-in'); }), 2000);
  }
</script>
