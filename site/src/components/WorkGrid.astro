---
import type { Content, Lang } from '../lib/content';
import { hasCasePage, uiLabels } from '../lib/content';
import { caseHref } from '../lib/paths';
interface Props { t: Content; lang: Lang }
const { t, lang } = Astro.props;
const ui = uiLabels(t, lang);
---

<!-- /work as an index: one hairline row per case, year and client on the left,
     title, result and the kinds of work in the middle, the case's lead number on
     the right on wide screens (below the text on narrow ones). No cards. -->
<ol class="work-list">
  {t.cases.items.map((item) => {
    const hasPage = hasCasePage(lang, item.slug);
    return (
      <li class="row" id={item.slug}>
        <a class="row__link" href={caseHref(lang, item.slug, hasPage)} data-cursor={t.cursor.view}>
          <div class="row__meta">
            <span class="row__year num">{item.year}</span>
            <span class="row__client">{item.client}</span>
          </div>
          <div class="row__body">
            <h2 class="row__title">{item.title} <span class="row__arrow" aria-hidden="true">→</span></h2>
            <p class="row__result">{item.result}</p>
            <p class="row__foot">
              <span class="row__role"><span class="muted">{ui.role}:</span> {item.role}</span>
              <span class="row__tags">{item.tags.join(' · ')}</span>
            </p>
          </div>
          <div class="row__fact">
            <span class="row__factn num">{item.facts[0][0]}</span>
            <span class="row__factl muted">{item.facts[0][1]}</span>
          </div>
        </a>
      </li>
    );
  })}
</ol>

<style>
  .work-list { list-style: none; margin: 0; padding: 0; border-top: var(--hairline) solid var(--line); }
  .row { border-bottom: var(--hairline) solid var(--line); scroll-margin-top: calc(var(--header-h) + var(--space-4)); }
  .row__link {
    display: grid;
    gap: var(--space-2) var(--space-8);
    padding-block: var(--space-6);
    text-decoration: none;
    color: inherit;
  }
  .row__meta { display: flex; gap: var(--space-3); font-size: var(--text-sm); color: var(--fg-muted); }
  .row__body { display: grid; gap: var(--space-3); min-width: 0; }
  .row__title { font-size: var(--text-lg); line-height: 1.2; font-weight: var(--weight-display); letter-spacing: -0.02em; text-wrap: balance; }
  .row__arrow { display: inline-block; color: var(--fg-muted); transition: transform var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out); }
  .row__result { font-size: var(--text-md); color: var(--fg-muted); max-width: var(--measure); line-height: 1.5; }
  .row__foot { display: grid; gap: var(--space-1); font-size: var(--text-sm); }
  .row__tags { color: var(--fg-muted); }
  .row__fact { display: flex; gap: var(--space-3); align-items: baseline; font-size: var(--text-sm); }
  .row__factn { font-size: var(--text-lg); font-weight: 500; letter-spacing: -0.02em; line-height: 1.2; }

  @media (min-width: 768px) {
    .row__link { grid-template-columns: 11rem minmax(0, 1fr); }
    .row__meta { flex-direction: column; gap: var(--space-1); padding-top: 0.35em; }
  }
  @media (min-width: 1024px) {
    .row__link { grid-template-columns: 11rem minmax(0, 1fr) minmax(0, 18rem); }
    .row__fact { display: grid; gap: var(--space-1); align-content: start; padding-top: 0.1em; }
    .row__factn { font-size: var(--text-xl); line-height: 1.1; }
  }
  @media (hover: hover) and (pointer: fine) {
    .row__link:hover .row__title { color: var(--accent); }
    .row__link:hover .row__arrow { transform: translateX(4px); color: var(--accent); }
  }
</style>
