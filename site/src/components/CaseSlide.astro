---
import type { CaseItem, Content, Lang } from '../lib/content';
import { getCaseBody, hasCasePage, uiLabels } from '../lib/content';
import { caseHref } from '../lib/paths';
import CornerMarks from './CornerMarks.astro';
import CaseFigure from './CaseFigure.astro';

interface Props { item: CaseItem; t: Content; lang: Lang; index: number }
const { item, t, lang } = Astro.props;
const ui = uiLabels(t, lang);
const hasPage = hasCasePage(lang, item.slug);
const href = caseHref(lang, item.slug, hasPage);
const titleId = `case-${item.slug}-title`;
/* The slide's visual is the case's hero image; until it exists, the same
   placeholder as the case page, with the caption describing what goes there. */
const heroFigure = getCaseBody(lang, item.slug)?.hero?.figure ?? item.title;
---

<section class="slide case" id={`case-${item.slug}`} aria-labelledby={titleId}>
  <article class="slide__box case__box">
    <CornerMarks />
    <!-- Touch: the whole card is the link, marked by the arrow top-right (garri pattern). -->
    <a class="case__cover touch-only" href={href} aria-labelledby={titleId}><span class="case__arrow" aria-hidden="true">↗</span></a>

    <div class="case__text">
      <h2 id={titleId} class="title-xl">{item.title}</h2>
      <p class="case__result measure">{item.result}</p>
      <dl class="case__meta">
        <div><dt>{t.casePage.client}</dt><dd>{item.client} · <span class="num">{item.year}</span></dd></div>
        <div><dt>{ui.role}</dt><dd>{item.role}</dd></div>
        <div><dt>{ui.scope}</dt><dd>{item.scope}</dd></div>
      </dl>
      <dl class="case__facts" aria-label={t.casePage.facts}>
        {item.facts.map(([n, caption]) => (
          <div class="case__fact"><dt class="case__num num">{n}</dt><dd class="muted">{caption}</dd></div>
        ))}
      </dl>
      <p><a class="case__cta desktop-only" href={href} data-cursor={t.cursor.view}>{t.cases.cta} <span aria-hidden="true">→</span></a></p>
    </div>

    <div class="case__visual">
      <CaseFigure caption={heroFigure} aspect="4 / 3" label={t.casePage.image} />
    </div>
  </article>
</section>

<style>
  .case__box { position: relative; }
  .case__cover { position: absolute; inset: 0; z-index: 2; border-radius: var(--radius-md); }
  .case__arrow {
    position: absolute; top: var(--space-4); right: var(--space-4);
    font-size: var(--text-lg); line-height: 1; color: var(--fg);
  }
  .case__text { display: grid; gap: var(--space-6); }
  .case__result { font-size: var(--text-md); line-height: 1.5; }

  /* Metadata as a compact definition list: quiet term, plain value. */
  .case__meta { margin: 0; display: grid; gap: var(--space-2); font-size: var(--text-sm); }
  .case__meta div { display: grid; grid-template-columns: 6rem minmax(0, 1fr); gap: var(--space-3); }
  .case__meta dt { color: var(--fg-muted); }
  .case__meta dd { margin: 0; }

  /* Facts as hairline rows, not stat tiles: number leads, caption follows. */
  .case__facts { margin: 0; display: grid; border-top: var(--hairline) solid var(--line); }
  .case__fact {
    display: grid; grid-template-columns: 4.5rem minmax(0, 1fr); gap: var(--space-3); align-items: baseline;
    padding-block: var(--space-2);
    border-bottom: var(--hairline) solid var(--line);
  }
  .case__num { font-size: var(--text-lg); font-weight: 500; line-height: 1.2; letter-spacing: -0.02em; }
  .case__fact dd { margin: 0; font-size: var(--text-sm); }

  .case__cta {
    display: inline-flex; gap: var(--space-2); align-items: center;
    color: var(--accent);
    font-weight: 500;
    text-decoration: none;
  }
  .case__cta:hover { text-decoration: underline; text-underline-offset: 0.2em; }

  .case__visual { min-width: 0; }
</style>
