---
import type { Content } from '../lib/content';
import CornerMarks from './CornerMarks.astro';
interface Props { t: Content }
const { t } = Astro.props;
---

<section class="slide about" id="about" aria-labelledby="about-title">
  <div class="slide__box about__box">
    <CornerMarks />
    <div class="about__text">
      <h2 id="about-title" class="about__h">{t.about.sectionLabel}</h2>
      <p>{t.about.p1}</p>
      <p>{t.about.p2}</p>
      <p class="about__p3">{t.about.p3}</p>
    </div>

    <div class="about__path">
      <h3 class="about__h">{t.timeline.sectionLabel}</h3>
      <ol class="about__eras">
        {t.timeline.eras.map((era) => (
          <li>
            <div class="about__era-head">
              <span class="about__era-name">{era.name}</span>
              <span class="about__era-years num muted">{era.years}</span>
            </div>
            <p class="muted">{era.text}</p>
          </li>
        ))}
      </ol>
      <h3 class="about__h">{t.timeline.clientsLabel}</h3>
      <ul class="about__clients">
        {t.timeline.clients.map((c) => <li>{c}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .about__text { display: grid; gap: var(--space-4); max-width: var(--measure); align-content: start; }
  .about__h { font-size: var(--text-md); font-weight: var(--weight-ui); letter-spacing: 0; color: var(--fg-muted); }
  .about__p3 { font-weight: 500; }
  .about__path { display: grid; gap: var(--space-4); align-content: start; }
  .about__eras { list-style: none; margin: 0; padding: 0; display: grid; }
  .about__eras li {
    display: grid; gap: var(--space-1);
    padding-block: var(--space-4);
    border-top: var(--hairline) solid var(--line);
    font-size: var(--text-sm);
  }
  .about__eras li:last-child { border-bottom: var(--hairline) solid var(--line); }
  .about__era-head { display: flex; justify-content: space-between; gap: var(--space-4); align-items: baseline; }
  .about__era-name { font-weight: 500; font-size: var(--text-md); }
  .about__era-years { font-size: var(--text-sm); white-space: nowrap; }
  /* Client names as a run of text separated by middle dots, not a chip cloud. */
  .about__clients { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0 var(--space-2); font-size: var(--text-md); line-height: 1.6; }
  .about__clients li { white-space: nowrap; }
  .about__clients li:not(:last-child)::after { content: '·'; margin-left: var(--space-2); color: var(--fg-faint, var(--fg-muted)); }
  @media (min-width: 1024px) {
    .about__box { align-items: start; }
    .about__path { margin-top: var(--space-2); }
  }
</style>
