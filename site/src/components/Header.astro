---
import type { Content, Lang } from '../lib/content';
import { otherLang, uiLabels } from '../lib/content';
import { pageHref, type Page } from '../lib/paths';
import ThemeToggle from './ThemeToggle.astro';

interface Props { lang: Lang; page: Page; t: Content; slug?: string }
const { lang, page, t, slug } = Astro.props;
const other = otherLang(lang);
const ui = uiLabels(t, lang);
const links = [
  { label: t.nav.work, href: pageHref(lang, 'work'), current: page === 'work' || page === 'case' },
  { label: t.nav.method, href: pageHref(lang, 'method'), current: page === 'method' },
  { label: t.nav.about, href: pageHref(lang, 'home', '#about') },
  { label: t.nav.contact, href: pageHref(lang, 'home', '#contact') },
];
---

<header class="header">
  <a class="header__name" href={pageHref(lang, 'home')}>{t.hero.name}</a>

  <nav class="header__nav" id="site-nav">
    <ul>
      {links.map((l) => (
        <li><a href={l.href} aria-current={l.current ? 'page' : undefined}>{l.label}</a></li>
      ))}
    </ul>
  </nav>

  <div class="header__tools">
    <a class="header__lang" href={pageHref(other, page, '', slug)} hreflang={other === 'pt' ? 'pt-BR' : 'en'} lang={other === 'pt' ? 'pt-BR' : 'en'} title={t.nav.langSwitchTitle}>
      {t.nav.langSwitch}
    </a>
    <ThemeToggle t={t} />
    <button class="header__menu" type="button" aria-expanded="false" aria-controls="site-nav">{ui.menu}</button>
  </div>
</header>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 10;
    height: var(--header-h);
    padding-inline: var(--gutter);
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: var(--space-4);
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: var(--hairline) solid var(--line);
    font-size: var(--text-sm);
    transition: background-color var(--dur-base) var(--ease-out), color var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out);
  }
  /* Over an inverse-ground section (Contact) the header flips with it instead
     of sitting as a band of the opposite tone across the top. */
  .header.is-inverse {
    --bg: var(--bg-inverse);
    --fg: var(--fg-inverse);
    --fg-muted: color-mix(in srgb, var(--fg-inverse) 62%, transparent);
    --line: color-mix(in srgb, var(--fg-inverse) 16%, transparent);
    --line-strong: color-mix(in srgb, var(--fg-inverse) 34%, transparent);
    color: var(--fg);
  }
  .header__name { font-weight: 500; text-decoration: none; white-space: nowrap; }
  .header__nav ul { list-style: none; margin: 0; padding: 0; display: flex; gap: var(--space-6); }
  .header__nav a { text-decoration: none; color: var(--fg-muted); transition: color var(--dur-fast) var(--ease-out); }
  .header__nav a:hover, .header__nav a[aria-current] { color: var(--fg); }
  .header__tools { display: flex; align-items: center; gap: var(--space-3); }
  .header__lang {
    text-decoration: none;
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--fg-muted);
    padding: var(--space-1) var(--space-2);
  }
  .header__lang:hover { color: var(--fg); }
  .header__menu {
    font: inherit;
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--fg);
    background: none;
    border: var(--hairline) solid var(--line-strong);
    border-radius: 999px;
    padding: var(--space-1) var(--space-3);
    cursor: pointer;
  }

  /* Mobile: name + compact tools row; nav is a panel revealed by the Menu button. */
  @media (max-width: 1023.98px) {
    .header__nav {
      position: absolute;
      top: 100%;
      left: 0; right: 0;
      padding: var(--space-4) var(--gutter) var(--space-6);
      background: var(--bg);
      border-bottom: var(--hairline) solid var(--line);
      display: none;
    }
    .header__nav.is-open { display: block; }
    .header__nav ul { flex-direction: column; gap: var(--space-4); font-size: var(--text-lg); }
  }
  @media (min-width: 1024px) {
    .header { grid-template-columns: 1fr auto 1fr; }
    .header__tools { justify-content: end; }
    .header__menu { display: none; }
  }
</style>

<script>
  /* Flip the header when an inverse-ground section reaches its lower edge. */
  const header = document.querySelector<HTMLElement>('.header');
  const grounds = Array.from(document.querySelectorAll<HTMLElement>('[data-ground="inverse"]'));
  if (header && grounds.length) {
    let raf = 0;
    const update = () => {
      raf = 0;
      const h = header.offsetHeight;
      const over = grounds.some((g) => { const r = g.getBoundingClientRect(); return r.top < h && r.bottom > h; });
      header.classList.toggle('is-inverse', over);
      /* The cursor reads data-ground to flip its bubble too. */
      if (over) header.setAttribute('data-ground', 'inverse'); else header.removeAttribute('data-ground');
    };
    const schedule = () => { if (!raf) raf = requestAnimationFrame(update); };
    window.addEventListener('scroll', schedule, { passive: true });
    document.querySelector('.main--snap')?.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
    update();
  }

  const btn = document.querySelector<HTMLButtonElement>('.header__menu');
  const nav = document.getElementById('site-nav');
  if (btn && nav) {
    btn.addEventListener('click', () => {
      const open = nav.classList.toggle('is-open');
      btn.setAttribute('aria-expanded', String(open));
    });
    nav.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) {
        nav.classList.remove('is-open');
        btn.setAttribute('aria-expanded', 'false');
      }
    });
  }
</script>
