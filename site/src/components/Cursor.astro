<div class="cursor" aria-hidden="true"><span class="cursor__label"></span></div>

<style is:global>
  /* Hide the native cursor everywhere while the custom one is active. Global and
     !important on purpose: Astro would otherwise scope `*` to this component, and
     component styles with `cursor: pointer` would show the native hand over the dot. */
  @media (hover: hover) and (pointer: fine) and (min-width: 1024px) {
    html[data-custom-cursor], html[data-custom-cursor] * { cursor: none !important; }
  }
</style>

<style>
  .cursor { display: none; }

  /* Desktop pointers only, and only once the script has taken over (html[data-custom-cursor]). */
  @media (hover: hover) and (pointer: fine) and (min-width: 1024px) {
    html[data-custom-cursor] .cursor {
      position: fixed;
      top: 0; left: 0;
      z-index: 100;
      display: grid;
      place-items: center;
      width: 12px;
      height: 12px;
      border-radius: 50%;
      /* Dot: white + difference blend = always the inverse of what is behind it, so
         it stays visible on the inverse-ground Contact section in both themes. */
      background: #fff;
      color: #000;
      mix-blend-mode: difference;
      pointer-events: none;
      will-change: transform;
      transform: translate(-50%, -50%);
      transition: width var(--dur-fast) var(--ease-out), height var(--dur-fast) var(--ease-out), opacity var(--dur-fast);
    }
    /* Hot (over a target): no inversion. A near-opaque, blurred bubble dims what is
       under it so the label stays legible over text; colors flip on inverse ground
       (data-ground="inverse" on the section, mirrored as .is-inverse by the script). */
    html[data-custom-cursor] .cursor.is-hot {
      width: 64px;
      height: 64px;
      mix-blend-mode: normal;
      background: color-mix(in srgb, var(--cursor) 90%, transparent);
      color: var(--cursor-fg);
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
    }
    html[data-custom-cursor] .cursor.is-hot.is-inverse {
      background: color-mix(in srgb, var(--cursor-fg) 90%, transparent);
      color: var(--cursor);
    }
    html[data-custom-cursor] .cursor.is-hidden { opacity: 0; }
    .cursor__label {
      font-size: var(--text-xs);
      text-transform: uppercase;
      letter-spacing: var(--tracking-label);
      font-weight: 500;
      opacity: 0;
      transition: opacity var(--dur-fast) var(--ease-out);
      white-space: nowrap;
    }
    .cursor.is-hot .cursor__label { opacity: 1; }
  }
</style>

<script>
  /* Custom cursor: 12px dot with a slight lerp; grows to 64px with a label
     (from data-cursor) over interactive targets. Never the only affordance. */
  const el = document.querySelector<HTMLElement>('.cursor');
  const label = el?.querySelector<HTMLElement>('.cursor__label');
  const mq = matchMedia('(hover: hover) and (pointer: fine) and (min-width: 1024px)');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (el && label) {
    let tx = -100, ty = -100, x = tx, y = ty, running = false;

    const frame = () => {
      const k = reduced ? 1 : 0.22;
      x += (tx - x) * k; y += (ty - y) * k;
      el.style.transform = `translate(${x - el.offsetWidth / 2}px, ${y - el.offsetHeight / 2}px)`;
      if (Math.abs(tx - x) > 0.1 || Math.abs(ty - y) > 0.1) requestAnimationFrame(frame);
      else running = false;
    };
    const move = (e: PointerEvent) => {
      tx = e.clientX; ty = e.clientY;
      el.classList.remove('is-hidden');
      if (!running) { running = true; requestAnimationFrame(frame); }
      const source = e.target as Element | null;
      const target = source?.closest<HTMLElement>('a, button, [data-cursor]');
      el.classList.toggle('is-hot', Boolean(target));
      el.classList.toggle('is-inverse', Boolean(source?.closest('[data-ground="inverse"]')));
      label.textContent = target?.dataset.cursor ?? '';
    };
    const hide = () => el.classList.add('is-hidden');

    const apply = () => {
      if (mq.matches) {
        document.documentElement.setAttribute('data-custom-cursor', '');
        el.style.transform = 'translate(-100px, -100px)';
        window.addEventListener('pointermove', move, { passive: true });
        document.addEventListener('mouseleave', hide);
      } else {
        document.documentElement.removeAttribute('data-custom-cursor');
        window.removeEventListener('pointermove', move);
        document.removeEventListener('mouseleave', hide);
      }
    };
    apply();
    mq.addEventListener('change', apply);
  }
</script>
