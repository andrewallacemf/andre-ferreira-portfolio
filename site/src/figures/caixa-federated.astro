---
/* CAIXA Design System · federated governance: a core team, ambassadors in each
   business area, product teams implementing in their own territory. */
import type { Lang } from '../lib/content';
interface Props { lang: Lang }
const { lang } = Astro.props;
const L = {
  pt: {
    core: ['Núcleo do', 'design system'],
    coreSub: 'StyleGuide · bibliotecas · portal',
    amb: 'Embaixadores',
    teams: 'Times de produto',
    areas: ['Habitação', 'Cartões', 'Conta Corrente', 'Aplicativos'],
    legend: ['mantém e evolui', 'adaptam, ajudam na adoção, implementam na própria área', 'usam e devolvem padrões'],
  },
  en: {
    core: ['Design system', 'core'],
    coreSub: 'StyleGuide · libraries · portal',
    amb: 'Ambassadors',
    teams: 'Product teams',
    areas: ['Housing', 'Cards', 'Checking accounts', 'Apps'],
    legend: ['maintains and evolves', 'adapt, help adoption, implement in their own area', 'use and return patterns'],
  },
}[lang];
const cx = 600, cy = 300, dx = 300, dy = 150, r = 74;
const nodes = [[-1, -1], [1, -1], [1, 1], [-1, 1]];
---

<svg viewBox="0 0 1200 700" role="img" aria-label={`${L.core.join(' ')} → ${L.amb} (${L.areas.join(', ')}) → ${L.teams}`}>
  <style>
    .k { fill: var(--fg-muted); font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; }
    .t { fill: var(--fg); font-weight: 700; font-size: 26px; letter-spacing: -0.02em; }
    .s { fill: var(--fg-muted); font-size: 16px; }
    .a { fill: var(--fg); font-weight: 500; font-size: 19px; }
    .core { fill: var(--accent-soft); stroke: var(--accent); stroke-width: 1.5; }
    .node { fill: var(--bg); stroke: var(--line-strong); stroke-width: 1.5; }
    .spoke { stroke: var(--line-strong); stroke-width: 1.5; }
    .leaf { fill: var(--fg-muted); }
    .leafline { stroke: var(--line); stroke-width: 1; }
    .core-t { fill: var(--accent); font-weight: 700; font-size: 24px; letter-spacing: -0.02em; }
  </style>

  <!-- spokes from the core to each area's ambassadors -->
  {nodes.map(([sx, sy]) => {
    const x = cx + sx * dx, y = cy + sy * dy;
    const len = Math.hypot(dx, dy); const ux = (sx * dx) / len, uy = (sy * dy) / len;
    return <line class="spoke" x1={cx + ux * 112} y1={cy + uy * 112} x2={x - ux * r} y2={y - uy * r} />;
  })}

  <!-- core -->
  <circle class="core" cx={cx} cy={cy} r="112" />
  <text class="core-t" x={cx} y={cy - 12} text-anchor="middle">{L.core[0]}</text>
  <text class="core-t" x={cx} y={cy + 18} text-anchor="middle">{L.core[1]}</text>
  <text class="s" x={cx} y={cy + 50} text-anchor="middle">{L.coreSub}</text>

  <!-- ambassadors per area, each with its product teams -->
  {nodes.map(([sx, sy], i) => {
    const x = cx + sx * dx, y = cy + sy * dy;
    const leaves = [-40, 0, 40];
    return (
      <g>
        {leaves.map((off) => (
          <g>
            <line class="leafline" x1={x + sx * r} y1={y} x2={x + sx * (r + 70)} y2={y + off} />
            <circle class="leaf" cx={x + sx * (r + 76)} cy={y + off} r="6" />
          </g>
        ))}
        <circle class="node" cx={x} cy={y} r={r} />
        <text class="k" x={x} y={y - 8} text-anchor="middle">{L.amb}</text>
        <text class="a" x={x} y={y + 18} text-anchor="middle">{L.areas[i]}</text>
      </g>
    );
  })}

  <!-- legend -->
  <g>
    <circle cx="48" cy="596" r="7" fill="var(--accent)" />
    <text class="s" x="64" y="601">{L.core.join(' ')}: {L.legend[0]}</text>
    <circle cx="48" cy="632" r="7" class="node" />
    <text class="s" x="64" y="637">{L.amb}: {L.legend[1]}</text>
    <circle cx="48" cy="668" r="6" class="leaf" />
    <text class="s" x="64" y="673">{L.teams}: {L.legend[2]}</text>
  </g>
</svg>
