---
/* CAIXA Design System · the structure diagram from the 2021 case, redrawn with
   the site's tokens. The composition is the original's: overlapping boxes show
   what each part of the system contains and shares; the edges of a box hidden by
   another are dashed, as in the source. Coordinates are the original's × 0.6. */
import type { Lang } from '../lib/content';
interface Props { lang: Lang }
const { lang } = Astro.props;
const L = {
  pt: {
    rules: ['Regras de', 'design e', 'desenv.'],
    principles: ['Princípios', 'de design'],
    practices: 'Boas práticas de design e desenvolvimento',
    visual: ['Guia', 'visual'], visualSub: '(marca)',
    styles: ['Guia de', 'estilos'],
    patterns: 'Biblioteca de padrões',
    designLib: 'Biblioteca de design', codeLib: 'Biblioteca de código',
    strategic: 'Design estratégico',
    func: 'Definições de funcionalidade', tech: 'Definições de tecnologia',
    system: 'Sistema de Design',
  },
  en: {
    rules: ['Design and', 'development', 'rules'],
    principles: ['Design', 'principles'],
    practices: 'Design and development practices',
    visual: ['Visual', 'guide'], visualSub: '(brand)',
    styles: ['Style', 'guide'],
    patterns: 'Pattern library',
    designLib: 'Design library', codeLib: 'Code library',
    strategic: 'Strategic design',
    func: 'Functional definitions', tech: 'Technology definitions',
    system: 'Design System',
  },
}[lang];
/* Boxes, back to front. */
const rules = { x: 29, y: 29, w: 1141, h: 194 };
const visual = { x: 29, y: 251, w: 417, h: 279 };
const practices = { x: 474, y: 56, w: 670, h: 615 };
const principles = { x: 223, y: 56, w: 195, h: 446 };
const styles = { x: 251, y: 280, w: 865, h: 193 };
const patterns = { x: 502, y: 306, w: 585, h: 139 };
const strategic = { x: 502, y: 502, w: 585, h: 140 };
const btn = { w: 251, h: 56 };
---

<svg class="fg-caixa-architecture" viewBox="0 0 1200 700" role="img" aria-label={`${L.system}: ${L.rules.join(' ')}, ${L.principles.join(' ')}, ${L.practices}, ${L.visual.join(' ')}, ${L.styles.join(' ')}, ${L.patterns} (${L.designLib}, ${L.codeLib}), ${L.strategic}`}>
  <style>
    .fg-caixa-architecture .box { fill: var(--bg-elev); stroke: var(--line-strong); stroke-width: 1.5; }
    .fg-caixa-architecture .hidden { fill: none; stroke: var(--line-strong); stroke-width: 1.5; stroke-dasharray: 5 7; }
    .fg-caixa-architecture .t { fill: var(--fg); font-weight: 700; font-size: 24px; letter-spacing: -0.02em; }
    .fg-caixa-architecture .s { fill: var(--fg-muted); font-size: 17px; }
    .fg-caixa-architecture .lib { fill: var(--accent); }
    .fg-caixa-architecture .lib-t { fill: var(--accent-fg); font-weight: 700; font-size: 19px; letter-spacing: -0.01em; }
    .fg-caixa-architecture .def { fill: var(--line); stroke: var(--line-strong); stroke-width: 1; }
    .fg-caixa-architecture .def-t { fill: var(--fg); font-size: 17px; }
    .fg-caixa-architecture .sys { fill: var(--accent); font-weight: 500; font-size: 30px; letter-spacing: -0.02em; }
  </style>

  <!-- back to front: each box hides what it covers -->
  <rect class="box" x={rules.x} y={rules.y} width={rules.w} height={rules.h} rx="12" />
  <rect class="box" x={visual.x} y={visual.y} width={visual.w} height={visual.h} rx="12" />
  <rect class="box" x={practices.x} y={practices.y} width={practices.w} height={practices.h} rx="12" />
  <rect class="box" x={principles.x} y={principles.y} width={principles.w} height={principles.h} rx="12" />
  <rect class="box" x={styles.x} y={styles.y} width={styles.w} height={styles.h} rx="12" />

  <!-- covered edges, drawn dashed as in the original -->
  <line class="hidden" x1={principles.x} y1={rules.y + rules.h} x2={principles.x + principles.w} y2={rules.y + rules.h} />
  <line class="hidden" x1={practices.x} y1={rules.y + rules.h} x2={practices.x + practices.w} y2={rules.y + rules.h} />
  <line class="hidden" x1={principles.x} y1={visual.y} x2={principles.x + principles.w} y2={visual.y} />
  <line class="hidden" x1={visual.x + visual.w} y1={styles.y} x2={visual.x + visual.w} y2={styles.y + styles.h} />
  <line class="hidden" x1={principles.x + principles.w} y1={styles.y} x2={principles.x + principles.w} y2={styles.y + styles.h} />
  <line class="hidden" x1={practices.x} y1={styles.y} x2={practices.x} y2={styles.y + styles.h} />

  <!-- inner blocks -->
  <rect class="box" x={patterns.x} y={patterns.y} width={patterns.w} height={patterns.h} rx="10" />
  <rect class="lib" x={patterns.x + 28} y={patterns.y + 57} width={btn.w} height={btn.h} rx="8" />
  <rect class="lib" x={patterns.x + patterns.w - 28 - btn.w} y={patterns.y + 57} width={btn.w} height={btn.h} rx="8" />
  <rect class="box" x={strategic.x} y={strategic.y} width={strategic.w} height={strategic.h} rx="10" />
  <rect class="def" x={strategic.x + 28} y={strategic.y + 56} width={btn.w} height={btn.h} rx="8" />
  <rect class="def" x={strategic.x + strategic.w - 28 - btn.w} y={strategic.y + 56} width={btn.w} height={btn.h} rx="8" />

  <!-- labels -->
  {L.rules.map((l, i) => <text class="t" x="126" y={100 + i * 30} text-anchor="middle">{l}</text>)}
  {L.principles.map((l, i) => <text class="t" x="320" y={150 + i * 30} text-anchor="middle">{l}</text>)}
  <text class="t" x={practices.x + practices.w / 2} y="150" text-anchor="middle">{L.practices}</text>
  {L.visual.map((l, i) => <text class="t" x="126" y={370 + i * 30} text-anchor="middle">{l}</text>)}
  <text class="s" x="126" y="432" text-anchor="middle">{L.visualSub}</text>
  {L.styles.map((l, i) => <text class="t" x="335" y={366 + i * 30} text-anchor="middle">{l}</text>)}
  <text class="t" x={patterns.x + patterns.w / 2} y={patterns.y + 38} text-anchor="middle">{L.patterns}</text>
  <text class="lib-t" x={patterns.x + 28 + btn.w / 2} y={patterns.y + 57 + 35} text-anchor="middle">{L.designLib}</text>
  <text class="lib-t" x={patterns.x + patterns.w - 28 - btn.w / 2} y={patterns.y + 57 + 35} text-anchor="middle">{L.codeLib}</text>
  <text class="t" x={strategic.x + strategic.w / 2} y={strategic.y + 38} text-anchor="middle">{L.strategic}</text>
  <text class="def-t" x={strategic.x + 28 + btn.w / 2} y={strategic.y + 56 + 34} text-anchor="middle">{L.func}</text>
  <text class="def-t" x={strategic.x + strategic.w - 28 - btn.w / 2} y={strategic.y + 56 + 34} text-anchor="middle">{L.tech}</text>
  <text class="sys" x="84" y="616">{L.system}</text>
</svg>
