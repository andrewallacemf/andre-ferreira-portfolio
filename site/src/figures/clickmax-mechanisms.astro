---
/* Clickmax · offer inheritance: what the code held. Three incompatible ways of
   sharing configuration between product and offer, and the one place where real
   inheritance happened. Abstract on purpose: the shapes, not the code paths. */
import type { Lang } from '../lib/content';
interface Props { lang: Lang }
const { lang } = Astro.props;
const L = {
  pt: {
    title: 'Três mecanismos de configuração compartilhada, incompatíveis entre si',
    mech: ['Mecanismo A', 'Mecanismo B', 'Mecanismo C'],
    mechSub: ['configuração compartilhada', 'configuração compartilhada', 'configuração compartilhada'],
    real: ['O único caso de', 'herança de verdade'],
    realSub: 'a oferta lê o produto na leitura',
    side: 'Efeito colateral encontrado: um cupom criado para "todas as ofertas" não alcançava ofertas criadas depois',
    product: 'Produto', offer: 'Oferta',
  },
  en: {
    title: 'Three mechanisms for shared configuration, incompatible with one another',
    mech: ['Mechanism A', 'Mechanism B', 'Mechanism C'],
    mechSub: ['shared configuration', 'shared configuration', 'shared configuration'],
    real: ['The only case of', 'real inheritance'],
    realSub: 'the offer reads the product on read',
    side: 'Side effect found: a coupon created for "all offers" did not reach offers created later',
    product: 'Product', offer: 'Offer',
  },
}[lang];
const cells = [40, 320, 600];
---

<svg class="fg-clickmax-mechanisms" viewBox="0 0 1200 500" role="img" aria-label={`${L.title}. ${L.real.join(" ")}.`}>
  <style>
    .fg-clickmax-mechanisms .k { fill: var(--fg-muted); font-size: 13px; letter-spacing: 0.1em; text-transform: uppercase; }
    .fg-clickmax-mechanisms .t { fill: var(--fg); font-weight: 700; font-size: 22px; letter-spacing: -0.02em; }
    .fg-clickmax-mechanisms .s { fill: var(--fg-muted); font-size: 16px; }
    .fg-clickmax-mechanisms .box { fill: var(--bg); stroke: var(--line-strong); stroke-width: 1.5; }
    .fg-clickmax-mechanisms .acc { fill: var(--accent-soft); stroke: var(--accent); stroke-width: 1.5; }
    .fg-clickmax-mechanisms .lbl { fill: var(--fg); font-size: 15px; font-weight: 500; }
    .fg-clickmax-mechanisms .wire { fill: none; stroke: var(--line-strong); stroke-width: 1.5; }
    .fg-clickmax-mechanisms .wire-acc { fill: none; stroke: var(--accent); stroke-width: 1.5; }
    .fg-clickmax-mechanisms .bar { fill: var(--line-strong); }
    .fg-clickmax-mechanisms .bar-x { fill: var(--fg-muted); }
    .fg-clickmax-mechanisms .note { fill: var(--fg-muted); font-size: 15px; }
  </style>

  <text class="k" x="40" y="44">{L.title}</text>

  {L.mech.map((name, i) => {
    const x = cells[i], y = 90;
    return (
      <g>
        <rect class="box" x={x} y={y} width="260" height="330" rx="12" />
        <text class="t" x={x + 24} y={y + 42}>{name}</text>
        <text class="s" x={x + 24} y={y + 68}>{L.mechSub[i]}</text>
        <!-- product block -->
        <rect class="box" x={x + 24} y={y + 110} width="200" height="64" rx="8" />
        <text class="lbl" x={x + 36} y={y + 134}>{L.product}</text>
        <rect class="bar" x={x + 36} y={y + 146} width="100" height="6" rx="3" />
        <rect class="bar" x={x + 36} y={y + 158} width="70" height="6" rx="3" />
        <!-- offer block -->
        <rect class="box" x={x + 24} y={y + 240} width="200" height="64" rx="8" />
        <text class="lbl" x={x + 36} y={y + 264}>{L.offer}</text>
        {i === 0 && <g><rect class="bar-x" x={x + 36} y={y + 276} width="100" height="6" rx="3" /><rect class="bar-x" x={x + 36} y={y + 288} width="70" height="6" rx="3" /><path class="wire" d={`M ${x + 124} ${y + 174} v 66`} stroke-dasharray="4 4" /></g>}
        {i === 1 && <g><rect class="bar-x" x={x + 36} y={y + 276} width="100" height="6" rx="3" /><path class="wire" d={`M ${x + 86} ${y + 276} v -124`} /><circle cx={x + 86} cy={y + 149} r="4" fill="var(--fg-muted)" /></g>}
        {i === 2 && <g><rect class="bar-x" x={x + 36} y={y + 276} width="130" height="6" rx="3" /><rect class="bar-x" x={x + 36} y={y + 288} width="40" height="6" rx="3" /></g>}
      </g>
    );
  })}

  <!-- the real one -->
  <g>
    <rect class="acc" x="880" y="90" width="280" height="330" rx="12" />
    <text class="t" x="904" y="128">{L.real[0]}</text>
    <text class="t" x="904" y="154">{L.real[1]}</text>
    <text class="s" x="904" y="180">{L.realSub}</text>
    <rect class="box" x="904" y="200" width="200" height="64" rx="8" />
    <text class="lbl" x="916" y="224">{L.product}</text>
    <rect class="bar" x="916" y="236" width="100" height="6" rx="3" />
    <rect class="bar" x="916" y="248" width="70" height="6" rx="3" />
    <rect class="box" x="904" y="330" width="200" height="64" rx="8" stroke="var(--accent)" />
    <text class="lbl" x="916" y="354">{L.offer}</text>
    <text class="s" x="916" y="378" style="font-size:13px">→ {L.product.toLowerCase()}</text>
    <path class="wire-acc" d="M 1004 330 v -66 m -6 8 l 6 -8 l 6 8" />
  </g>

  <text class="note" x="40" y="470">{L.side}</text>
</svg>
