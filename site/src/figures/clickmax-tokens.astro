---
/* Clickmax design system · alias graph: primitive palettes → semantic tokens in
   two modes → component tokens. Five tokens as the worked example; the real
   palette values come from the library (neutral scale and the lime). */
import type { Lang } from '../lib/content';
interface Props { lang: Lang }
const { lang } = Astro.props;
const L = {
  pt: {
    cols: [['Primitivas', '7 paletas · 132 variáveis'], ['Semânticos', '58 tokens · modo claro e escuro'], ['Componente', '48 tokens']],
    light: 'claro', dark: 'escuro',
    note: 'exemplo com cinco tokens; o arquivo completo tem 238 variáveis geradas desta forma',
  },
  en: {
    cols: [['Primitives', '7 palettes · 132 variables'], ['Semantic', '58 tokens · light and dark'], ['Component', '48 tokens']],
    light: 'light', dark: 'dark',
    note: 'five tokens as the example; the full file has 238 variables generated this way',
  },
}[lang];
/* Real primitive values from the library's neutral scale and brand lime. */
const prim = [
  ['neutral-0', '#FFFFFF'], ['neutral-100', '#F4F5F5'], ['neutral-300', '#DEE0E2'], ['neutral-600', '#697077'],
  ['neutral-900', '#1F2123'], ['neutral-950', '#131416'], ['lime-500', '#D4FF00'], ['lime-600', '#CBF209'],
];
/* semantic: name, light primitive index, dark primitive index */
const sem = [
  ['surface/base', 0, 5], ['surface/raised', 1, 4], ['border/subtle', 2, 4], ['text/primary', 4, 1], ['action/primary', 6, 6],
];
/* component: name, semantic index */
const comp = [
  ['button/primary/bg', 4], ['button/primary/text', 3], ['card/bg', 1], ['card/border', 2], ['page/bg', 0],
];
const x1 = 40, x2 = 470, x3 = 880;
const y0 = 120, rowP = 58, rowS = 92, rowC = 92;
const py = (i: number) => y0 + i * rowP;
const sy = (i: number) => y0 + 24 + i * rowS;
const cy = (i: number) => y0 + 24 + i * rowC;
---

<svg class="fg-clickmax-tokens" viewBox="0 0 1200 680" role="img" aria-label={L.cols.map((c) => c[0]).join(' → ')}>
  <style>
    .fg-clickmax-tokens .k { fill: var(--fg-muted); font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; }
    .fg-clickmax-tokens .t { fill: var(--fg); font-weight: 700; font-size: 24px; letter-spacing: -0.02em; }
    .fg-clickmax-tokens .s { fill: var(--fg-muted); font-size: 16px; }
    .fg-clickmax-tokens .m { fill: var(--fg); font-size: 16px; font-family: var(--font-mono); }
    .fg-clickmax-tokens .mm { fill: var(--fg-muted); font-size: 13px; font-family: var(--font-mono); }
    .fg-clickmax-tokens .sw { stroke: var(--line-strong); stroke-width: 1; }
    .fg-clickmax-tokens .wire { fill: none; stroke: var(--line-strong); stroke-width: 1; opacity: 0.8; }
    .fg-clickmax-tokens .wire-acc { fill: none; stroke: var(--accent); stroke-width: 1.5; }
    .fg-clickmax-tokens .note { fill: var(--fg-muted); font-size: 15px; }
  </style>

  {[x1, x2, x3].map((x, i) => (
    <g>
      <text class="t" x={x} y="56">{L.cols[i][0]}</text>
      <text class="s" x={x} y="82">{L.cols[i][1]}</text>
    </g>
  ))}

  <!-- primitives -->
  {prim.map(([name, hex], i) => (
    <g>
      <rect class="sw" x={x1} y={py(i)} width="40" height="40" rx="8" fill={hex} />
      <text class="m" x={x1 + 56} y={py(i) + 20}>{name}</text>
      <text class="mm" x={x1 + 56} y={py(i) + 38}>{hex}</text>
    </g>
  ))}

  <!-- semantic: two swatches (light, dark) -->
  <text class="k" x={x2 + 20} y={y0 + 8} text-anchor="middle">{L.light}</text>
  <text class="k" x={x2 + 76} y={y0 + 8} text-anchor="middle">{L.dark}</text>
  {sem.map(([name, li, di], i) => (
    <g>
      <rect class="sw" x={x2} y={sy(i)} width="40" height="40" rx="8" fill={prim[li as number][1]} />
      <rect class="sw" x={x2 + 56} y={sy(i)} width="40" height="40" rx="8" fill={prim[di as number][1]} />
      <text class="m" x={x2 + 116} y={sy(i) + 20}>{name}</text>
      <text class="mm" x={x2 + 116} y={sy(i) + 38}>{prim[li as number][0]} · {prim[di as number][0]}</text>
      <path class={i === 4 ? 'wire-acc' : 'wire'} d={`M ${x1 + 40} ${py(li as number) + 20} C ${x1 + 240} ${py(li as number) + 20}, ${x2 - 200} ${sy(i) + 20}, ${x2} ${sy(i) + 20}`} />
    </g>
  ))}

  <!-- component -->
  {comp.map(([name, si], i) => (
    <g>
      <rect class="sw" x={x3} y={cy(i)} width="40" height="40" rx="8" fill={prim[sem[si as number][1] as number][1]} />
      <rect class="sw" x={x3 + 56} y={cy(i)} width="40" height="40" rx="8" fill={prim[sem[si as number][2] as number][1]} />
      <text class="m" x={x3 + 116} y={cy(i) + 20}>{name}</text>
      <text class="mm" x={x3 + 116} y={cy(i) + 38}>→ {sem[si as number][0]}</text>
      <path class={si === 4 ? 'wire-acc' : 'wire'} d={`M ${x2 + 96 + 240} ${sy(si as number) + 20} C ${x2 + 380} ${sy(si as number) + 20}, ${x3 - 60} ${cy(i) + 20}, ${x3} ${cy(i) + 20}`} />
    </g>
  ))}

  <text class="note" x="40" y="656">{L.note}</text>
</svg>
