---
/* Long-form case page: /work/<slug>/ and /pt/work/<slug>/.
   Header (from cases.items) + lede + hero figure, then the sections from the
   case body JSON. Normal flowing document, one reading column, sticky section
   index on wide screens. */
import type { Lang } from '../lib/content';
import { getContent, getCaseBody, hasCasePage } from '../lib/content';
import { caseHref, pageHref } from '../lib/paths';
import BaseLayout from '../layouts/BaseLayout.astro';
import CornerMarks from '../components/CornerMarks.astro';
import CaseFigure from '../components/CaseFigure.astro';
import Footer from '../components/Footer.astro';

interface Props { lang: Lang; slug: string }
const { lang, slug } = Astro.props;
const t = getContent(lang);
const item = t.cases.items.find((c) => c.slug === slug);
const body = getCaseBody(lang, slug);
if (!item || !body) throw new Error(`Case page without content: ${slug} (${lang})`);
const ui = t.casePage;
const next = body.next ? t.cases.items.find((c) => c.slug === body.next) : undefined;
const nextHref = next ? caseHref(lang, next.slug, hasCasePage(lang, next.slug)) : undefined;
---

<BaseLayout lang={lang} page="case" slug={slug} t={t} title={item.title} description={item.result}>
  <article class="case-page">
    <header class="slide case-head">
      <div class="slide__box slide__box--single case-head__box">
        <CornerMarks />
        <p class="case-head__back"><a class="link" href={pageHref(lang, 'work')}>← {ui.back}</a></p>
        <h1 class="display">{item.title}</h1>
        <p class="case-head__lede">{body.lede}</p>
        <dl class="case-head__meta">
          <div><dt>{ui.client}</dt><dd>{item.client} · <span class="num">{item.year}</span></dd></div>
          <div><dt>{ui.role}</dt><dd>{item.role}</dd></div>
          <div><dt>{ui.scope}</dt><dd>{item.scope}</dd></div>
          <div><dt>{ui.tags}</dt><dd>{item.tags.join(' · ')}</dd></div>
        </dl>
      </div>
    </header>

    {body.hero && (
      <div class="case-hero">
        <CaseFigure caption={body.hero.figure} aspect={body.hero.aspect} label={ui.image} />
      </div>
    )}

    <div class="case-body">
      <nav class="case-index wide-only" aria-label={ui.contents} data-spy>
        <p class="label">{ui.contents}</p>
        <ol>
          {body.sections.map((s) => <li><a href={`#${s.id}`}>{s.label}</a></li>)}
        </ol>
      </nav>

      <div class="case-sections">
        {body.sections.map((s, i) => (
          <section class="case-section slide" id={s.id} aria-labelledby={`${s.id}-title`}>
            <h2 id={`${s.id}-title`} class="title-xl">{s.title}</h2>
            {s.paragraphs?.map((p) => <p class="case-p">{p}</p>)}
            {s.bullets && (
              <ul class="case-bullets">
                {s.bullets.map((b) => <li>{b}</li>)}
              </ul>
            )}
            {s.steps && (
              <ol class="case-steps">
                {s.steps.map((st, n) => (
                  <li>
                    <span class="label num">{String(n + 1).padStart(2, '0')}</span>
                    <div><h3>{st.title}</h3><p>{st.text}</p></div>
                  </li>
                ))}
              </ol>
            )}
            {s.decisions && (
              <dl class="case-decisions">
                {s.decisions.map((d) => (
                  <div class="decision">
                    <dt>{d.title}</dt>
                    <dd>{d.text}</dd>
                  </div>
                ))}
              </dl>
            )}
            {s.showFacts && (
              <dl class="case-facts" aria-label={ui.facts}>
                {item.facts.map(([n, l]) => (
                  <div class="fact"><dt class="fact__n num">{n}</dt><dd class="muted">{l}</dd></div>
                ))}
              </dl>
            )}
            {s.figure && (
              <div><CaseFigure caption={s.figure} aspect={s.aspect} label={ui.image} /></div>
            )}
          </section>
        ))}
      </div>
    </div>

    <footer class="slide case-foot">
      <div class="slide__box slide__box--single case-foot__box">
        <CornerMarks />
        {next && nextHref && (
          <a class="case-next" href={nextHref} data-cursor={t.cursor.view}>
            <span class="case-next__kicker muted">{ui.next}</span>
            <span class="case-next__title title-xl">{next.title} <span class="case-next__arrow" aria-hidden="true">→</span></span>
            <span class="muted">{next.result}</span>
          </a>
        )}
        <a class="link" href={pageHref(lang, 'work')}>← {ui.back}</a>
        <Footer t={t} />
      </div>
    </footer>
  </article>
</BaseLayout>

<style>
  .case-page { display: grid; gap: var(--space-8); }

  /* Header block */
  .case-head { padding-bottom: 0; }
  .case-head__box { gap: var(--space-6); }
  .case-head__lede { font-size: var(--text-lg); line-height: 1.4; max-width: var(--measure); color: var(--fg-muted); }
  .case-head__back { font-size: var(--text-sm); }
  .case-head__meta { display: grid; gap: var(--space-2); margin: 0; max-width: var(--measure); font-size: var(--text-sm); border-top: var(--hairline) solid var(--line); padding-top: var(--space-4); }
  .case-head__meta div { display: grid; grid-template-columns: 8.5rem minmax(0, 1fr); gap: var(--space-3); }
  .case-head__meta dt { color: var(--fg-muted); }
  .case-head__meta dd { margin: 0; }

  /* Hero figure spans the reading area */
  .case-hero { padding-inline: var(--gutter); }
  .case-hero > :global(.figure) { max-width: var(--slide-max); margin-inline: auto; }
  /* Until the real image exists, the hero panel is capped so it never becomes a
     screen-tall empty block on wide displays; the real image will set its own height. */
  .case-hero :global(.figure__panel) { max-height: min(56vh, 34rem); }

  /* Body: index + sections */
  .case-body {
    padding-inline: var(--gutter);
    max-width: var(--slide-max);
    width: 100%;
    margin-inline: auto;
    display: grid;
    gap: var(--space-8);
  }
  .case-index { display: none; }
  /* Text keeps the measure; figures may use the whole reading area so images
     read large next to a narrow column of prose. */
  .case-sections { display: grid; gap: var(--space-4); }
  .case-section { padding: var(--space-8) 0; display: grid; gap: var(--space-4); border-top: var(--hairline) solid var(--line); }
  .case-section > :not(div) { max-width: var(--measure); }
  .case-section > div { max-width: none; padding-top: var(--space-2); }
  .case-section:first-child { border-top: 0; }
  .case-p { font-size: var(--text-md); line-height: var(--leading-relaxed, 1.6); }
  .case-bullets { margin: 0; padding-left: 1.1em; display: grid; gap: var(--space-3); line-height: var(--leading-relaxed, 1.6); }
  .case-bullets li::marker { color: var(--accent); }

  .case-steps { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-4); }
  .case-steps li { display: grid; grid-template-columns: 2.5rem 1fr; gap: var(--space-3); padding-top: var(--space-3); border-top: var(--hairline) solid var(--line); }
  .case-steps h3 { font-size: var(--text-md); font-weight: var(--weight-ui); letter-spacing: 0; margin: 0 0 var(--space-1); }
  .case-steps p { margin: 0; color: var(--fg-muted); }

  /* Decisions and findings as a hairline list: title, then text. No boxes. */
  .case-decisions { margin: 0; display: grid; border-top: var(--hairline) solid var(--line); }
  .decision { padding-block: var(--space-4); border-bottom: var(--hairline) solid var(--line); display: grid; gap: var(--space-2); }
  .decision dt { font-size: var(--text-md); font-weight: 500; }
  .decision dd { margin: 0; color: var(--fg-muted); line-height: 1.6; }

  /* Facts as rows: number leads, caption follows. */
  .case-facts { margin: 0; display: grid; border-top: var(--hairline) solid var(--line); }
  .fact { display: grid; grid-template-columns: 5.5rem minmax(0, 1fr); gap: var(--space-3); align-items: baseline; padding-block: var(--space-3); border-bottom: var(--hairline) solid var(--line); }
  .fact__n { font-size: var(--text-xl); line-height: 1.1; font-weight: 500; letter-spacing: -0.02em; }
  .fact dd { margin: 0; font-size: var(--text-sm); }

  /* Foot: next case + back */
  .case-foot__box { gap: var(--space-8); }
  .case-next { display: grid; gap: var(--space-3); text-decoration: none; color: inherit; padding-top: var(--space-6); border-top: var(--hairline) solid var(--line-strong); max-width: var(--measure); }
  .case-next__kicker { font-size: var(--text-sm); }
  .case-next__title { text-wrap: balance; }
  .case-next__arrow { display: inline-block; color: var(--fg-muted); transition: transform var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out); }
  @media (hover: hover) and (pointer: fine) { .case-next:hover .case-next__title { color: var(--accent); } .case-next:hover .case-next__arrow { transform: translateX(6px); color: var(--accent); } }

  @media (min-width: 1024px) {
    .case-head__box { padding-top: var(--space-12); }
    .case-body { grid-template-columns: 14rem minmax(0, 1fr); gap: var(--space-16); align-items: start; }
    .case-index { display: grid; gap: var(--space-3); position: sticky; top: calc(var(--header-h) + var(--space-8)); }
    .case-index ol { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-2); }
    .case-index a { color: var(--fg-muted); text-decoration: none; font-size: var(--text-sm); display: block; padding-left: var(--space-3); border-left: 2px solid transparent; margin-left: -2px; transition: color var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out); }
    .case-index a:hover { color: var(--fg); }
    .case-index a[aria-current] { color: var(--fg); border-color: var(--accent); }
    .case-index ol { border-left: var(--hairline) solid var(--line); }
  }
</style>

<script>
  /* Section index follows the reading position: the section whose top has
     passed the upper third of the viewport is the current one. */
  const nav = document.querySelector<HTMLElement>('[data-spy]');
  if (nav) {
    const links = Array.from(nav.querySelectorAll<HTMLAnchorElement>('a[href^="#"]'));
    const sections = links
      .map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))))
      .filter((s): s is HTMLElement => Boolean(s));
    let raf = 0;
    const update = () => {
      raf = 0;
      const line = window.innerHeight * 0.34;
      let current: HTMLElement | undefined;
      for (const s of sections) { if (s.getBoundingClientRect().top <= line) current = s; }
      links.forEach((a) => {
        if (current && a.hash === `#${current.id}`) a.setAttribute('aria-current', 'true');
        else a.removeAttribute('aria-current');
      });
    };
    const schedule = () => { if (!raf) raf = requestAnimationFrame(update); };
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
    update();
  }
</script>
